# Generic example environment for RNA004 m6A benchmarking.
# Copy to an untracked local file before editing.

SAMPLE_ID=sample_id
CELL_LINE=HEK293T_or_HeLa
POD5=/path/to/input.pod5_or_pod5_directory
BAM=/path/to/aligned.sorted.bam
FASTQ=/path/to/reads.fastq
BLOW5=/path/to/reads.blow5
TRANSCRIPT_FASTA=/path/to/gencode.v49.transcripts.clean.fa
GENOME_FASTA=/path/to/GRCh38.fa
GTF=/path/to/gencode.v49.annotation.gtf
GROUND_TRUTH=/path/to/ground_truth.tsv
OUTDIR=/path/to/output
THREADS=8

DORADO=/path/to/dorado
DORADO_MODEL=/path/to/dorado_model
SAMTOOLS=/path/to/samtools
MODKIT=/path/to/modkit
F5C=/path/to/f5c
BLUECRAB=/path/to/blue-crab
M6ANET=/path/to/m6anet
DEEPRM=/path/to/deeprm
DEEPRM_MODEL_FILE=/path/to/deeprm_weights.pt
SINGLEMOD_REPO=/path/to/SingleMod
BEDTOOLS=/path/to/bedtools
PYTHON=python
KMER_MODEL=/path/to/rna004.nucleotide.5mer.model
