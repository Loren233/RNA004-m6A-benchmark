# HeLa example environment.
# Primary ground truth: eTAM.

CELL_LINE=HeLa
GROUND_TRUTH_TYPE=eTAM
M6ANET_PRETRAINED_MODEL=HEK293T_RNA004
M6ANET_MODEL_NOTE="Cross-cell-line use of the HEK293T RNA004 pretrained model; not a HeLa-specific model."

# Fill these in locally.
SAMPLE_ID=hela_sample_id
POD5=/path/to/hela.pod5_or_directory
GROUND_TRUTH=/path/to/etam_sites.tsv
OUTDIR=/path/to/results/hela
